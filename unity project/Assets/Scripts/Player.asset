      Bar","body":"Get the child at position 2 (index 1) which is the health bar.","colorTheme":"Blue","guid":"3f7c22f2-7f11-4a66-8c61-f679a60ce6bb","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-8282.0,"yMin":330.0,"xMax":-8186.0,"yMax":394.0},"title":"Initialise","body":"number","colorTheme":"Green","guid":"f86aedda-1679-403c-8552-d2fb29acc68e","$type":"Unity.VisualScripting.StickyNote"},{"position":{"xMin":-5189.0,"yMin":5798.0,"xMax":-5083.0,"yMax":5877.0},"title":"Jumping","body":"If
